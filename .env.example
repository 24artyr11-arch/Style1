TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# A vision model with Responses API + Structured Outputs support.
OPENAI_MODEL=gpt-5.1
# Image edit model used for complete outfit boards and optional virtual try-on.
OPENAI_IMAGE_MODEL=gpt-image-2
# Different users are processed in parallel; one user's updates remain ordered.
WORKER_COUNT=4
DATA_DIR=/data
# Stable Docker volume name for the SQLite wardrobe database.
WARDROBE_VOLUME_NAME=style1_wardrobe_data
